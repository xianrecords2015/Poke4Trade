# Staging environment configuration.
# Copy this file to /home/pi/poke4trade-staging/.env on pinas and fill in values.
# Variables set in the systemd unit (poke4trade-staging.service) win over .env.
#   - PORT=8082 is set in the unit; do not duplicate here.
#   - NODE_ENV=production is set in the unit.
#   - DB_NAME=poke4trade_staging is set in the unit.
# DB_HOST / DB_USER / DB_PASSWORD default to the prod values hardcoded in
# server/database.js. Override here only if staging connects elsewhere.

# Stripe — use TEST keys so staging never charges real cards.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# PayPal — use a sandbox app's credentials.
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME
PAYPAL_MODE=sandbox

# SMTP — recommend pointing at a sink (Mailtrap, Mailpit) or staging@poke4trade.com
# so test traffic doesn't email real customers.
# Leave SMTP_USER blank to disable email entirely — sendTradeEmail short-circuits
# when SMTP_USER is unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# NOTE: server-side, sync-verify.js hardcodes a Telegram bot token (and the prod
# TCG API key). If you ever run that script from this staging checkout, swap the
# token at the top of the file or it will post to the prod-bound channel. For
# normal request traffic this is irrelevant.
